# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in what you want. Both are optional:
# with neither, the app still runs.
# ---------------------------------------------------------------------------

# Who writes the story after each round. Google AI Studio has a free tier
# (aistudio.google.com/apikey). Without a key, rounds are narrated by a local
# template instead — playable, just flatter.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash, which is on the free tier. Change it
# only if that model stops being available to your key; the server log tells
# you if so.
GEMINI_MODEL=

# Alternative narrator. Only used when GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=

# Saved runs and the short /run/[id] links. Any Postgres works — Vercel
# Postgres, Supabase, Neon. Without it, runs are held in memory and vanish on a
# restart (fine for trying it out, not for a deployment).
DATABASE_URL=
