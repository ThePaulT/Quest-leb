# Story generation. Without it the app still plays: every round falls back to a
# deterministic template narration written from the same facts.
ANTHROPIC_API_KEY=

# Saved runs and the short /run/[id] links. Any Postgres works — Vercel
# Postgres, Supabase, Neon. Without it runs are held in memory and vanish on a
# restart (fine for `npm run dev`, not for a deployment).
DATABASE_URL=
