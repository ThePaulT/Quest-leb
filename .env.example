# Supabase. `supabase start` prints these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2. Read only through lib/storage.ts; routes never touch the client.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL, no trailing slash: the bucket's r2.dev domain or a custom
# domain. The bucket must allow public reads — npm run verify:r2 checks this.
R2_PUBLIC_URL=

# Postgres. `supabase start` prints this; local fallback is printed by
# ./scripts/local-db.sh. Server-only — bypasses RLS.
DATABASE_URL=

# Supabase JWT secret, used to verify access tokens on API routes.
SUPABASE_JWT_SECRET=
