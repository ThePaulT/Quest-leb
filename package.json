{
  "name": "quest-leb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:local": "./scripts/local-db.sh",
    "db:local:reset": "./scripts/local-db.sh --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --experimental-strip-types --import ./scripts/register-aliases.mjs supabase/seed/seed.ts",
    "verify:r2": "node --env-file-if-exists=.env.local --experimental-strip-types --import ./scripts/register-aliases.mjs scripts/verify-r2.ts",
    "content:review": "node --experimental-strip-types --import ./scripts/register-aliases.mjs scripts/quests-review-csv.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12",
    "maplibre-gl": "^6.9.1",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
